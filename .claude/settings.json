{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read(**)",
      "Glob",
      "Grep",
      "Edit(/code/**)",
      "Edit(/src/**)",
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm test)"
    ],
    "ask": [
      "Edit(/code/**)"
    ],
    "deny": [
      "Read(/data/chunks/**)",
      "Read(/data/docs/**/*.pdf)",
      "Read(/docs/**)",
      "Read(/docs/*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(/.env)",
      "Read(/.env.*)",
      "Read(/.env/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.env/**)",
      "Read(/chroma.sqlite3)",
      "Edit(/data/**)",
      "Edit(.env*)",
      "Edit(/.env*)",
      "Edit(/.env/**)",
      "Edit(**/.env*)",
      "Edit(**/.env/**)",
      "Edit(.claude/**)",
      "Bash(git commit *)",
      "Bash(git push *)"
    ]
  }
}